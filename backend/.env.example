# ===== Chaukas AI backend config (copy to .env) =====
# --- AI (KodeKey, OpenAI-compatible) ---
KODEKEY_API_KEY=
KODEKEY_BASE_URL=https://api.ai.kodekloud.com/v1
VISION_MODEL=google/gemini-3.5-flash

# --- Database ---
# MongoDB Atlas URI (mongodb+srv://user:pass@cluster/...). Khali chhodo to local file DB (backend/data/db.json) chalega.
MONGODB_URI=
MONGODB_DB=chaukas

# --- Admin panel (LAUNCH SE PEHLE BADLO) ---
ADMIN_USER=admin
ADMIN_PASS=Chaukas@2026
JWT_SECRET=

# --- Optional ---
# n8n / Zapier / Make webhook: har nayi complaint ka JSON yahan POST hota hai
N8N_WEBHOOK_URL=
# Comma-separated allowed origins (frontend alag host par ho to). Same-origin ke liye zaroorat nahi.
CORS_ORIGINS=*
# true = pehli baar khali DB mein 40 demo complaints daalta hai (dashboard bhara dikhe)
SEED_DEMO=true
# department email (demo)
DEPT_EMAIL=demo@chaukas.test
